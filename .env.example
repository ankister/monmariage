# =====================================================================
#  Configuration du site de mariage — copiez ce fichier en « .env »
#  (cp .env.example .env) puis adaptez les valeurs.
#  Le fichier .env ne doit JAMAIS être envoyé sur GitHub (déjà ignoré).
# =====================================================================

# Port sur lequel le site est exposé sur le serveur (cible de Nginx Proxy Manager)
WEB_PORT=8095

# Dossier où est stockée la base de données (à inclure dans vos sauvegardes)
# Exemple Unraid : /mnt/user/appdata/monmariage/data
DATA_PATH=./data

# Utilisateur/groupe propriétaire des fichiers de données
# Debian/Ubuntu : 1000/1000 — Unraid : 99/100
PUID=1000
PGID=1000

# Prénoms affichés dans les jeux (sans apostrophe ni guillemet)
PRENOM_MARIE=Hugo
PRENOM_MARIEE=Léa

# Fuseau horaire des journaux
TZ=Europe/Paris

# --- Mot de passe de l'administration (utilisé UNIQUEMENT au premier démarrage) ---
# Recommandé : un hash généré par
#   docker compose run --rm api node scripts/hash-password.js
# puis collé tel quel ci-dessous (avec les apostrophes) :
ADMIN_PASSWORD_HASH=
#
# Alternative plus simple mais moins sûre : mot de passe en clair, haché au premier
# démarrage. Supprimez la ligne une fois le site lancé.
ADMIN_PASSWORD=
#
# Ensuite, le mot de passe se change depuis l'administration (onglet Sécurité).

# Code d'invitation initial (facultatif). Si renseigné, les invités doivent le saisir
# pour répondre ou réserver. Modifiable ensuite dans l'admin (onglet Sécurité).
INVITE_CODE=
