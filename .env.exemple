# Copier en .env à côté du docker-compose.yml (ne jamais committer le .env)
# Générer les secrets : openssl rand -hex 24

ADMIN_PASSWORD=remplace_moi
SESSION_SECRET=remplace_moi_par_une_longue_chaine

# Code demandé aux invités avant d'afficher le site (laisser vide pour un site ouvert)
SITE_CODE=

# Notifications à chaque réponse (facultatif)
DISCORD_WEBHOOK_URL=
NTFY_URL=
