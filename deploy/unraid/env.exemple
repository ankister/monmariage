# Réglages de la pile « monmariage » (fichier .env dans Compose Manager)

# Port du site sur le serveur (cible de Nginx Proxy Manager)
WEB_PORT=8095

# Dossier des données (base, photos, logo) — à inclure dans les sauvegardes
# Si appdata est sur un pool de cache, le chemin direct du pool évite la couche FUSE : /mnt/<pool>/appdata/monmariage/data
DATA_PATH=/mnt/user/appdata/monmariage/data

# Utilisateur Unraid propriétaire des données (réglé automatiquement au démarrage)
PUID=99
PGID=100
TZ=Europe/Paris

# Prénoms affichés dans les jeux (sans apostrophe ni guillemet)
PRENOM_MARIE=
PRENOM_MARIEE=

# Mot de passe admin du PREMIER démarrage uniquement : connectez-vous, changez-le dans
# l'onglet Sécurité de l'admin, puis videz cette ligne et relancez la pile.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Code d'invitation (facultatif, modifiable ensuite dans l'admin)
INVITE_CODE=
