# Nginx du conteneur « web » : sert le site statique et relaie /api vers le conteneur « api ».
# Nginx Proxy Manager (NPM) se place devant et gère le HTTPS.
#
# Modèle : au démarrage, l'image nginx remplace ${PRENOM_MARIE}, ${PRENOM_MARIEE}, ${TEMOINS_MARIE} et ${TEMOINS_MARIEE} par les valeurs
# des variables d'environnement (fichier .env). Les fichiers du site ne contiennent donc aucun prénom :
# l'image peut être publiée sans données personnelles.

# Si NPM indique le protocole d'origine (https), on le transmet ; sinon on prend celui de la connexion.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    # Photos des chambres (réduites dans le navigateur avant envoi, ~300 Ko en général)
    client_max_body_size 10m;
    charset utf-8;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain text/calendar text/csv;

    # --- En-têtes de sécurité (déclarés uniquement ici pour s'appliquer partout) ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    # Seules les tuiles OpenStreetMap sont chargées depuis l'extérieur
    # Spotify : pochettes (i.scdn.co, spotifycdn.com) et lecteur d'extraits intégré (open.spotify.com, chargé au clic)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://i.scdn.co https://*.spotifycdn.com; font-src 'self'; connect-src 'self'; frame-src 'self' https://open.spotify.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    # Prénoms des mariés insérés dans les pages et scripts des jeux (marqueurs __PRENOM_MARIE__ / __PRENOM_MARIEE__)
    sub_filter_types application/javascript;
    sub_filter_once off;
    sub_filter '__PRENOM_MARIEE__' '${PRENOM_MARIEE}';
    sub_filter '__PRENOM_MARIE__' '${PRENOM_MARIE}';
    # Témoins du « combat des témoins » (format Prénom:H|F[:peau 1-6[:cheveux]], séparés par des virgules)
    sub_filter '__TEMOINS_MARIEE__' '${TEMOINS_MARIEE}';
    sub_filter '__TEMOINS_MARIE__' '${TEMOINS_MARIE}';

    # Tableaux d'honneur des jeux : chaque jeu appelle « api/scores » à côté de sa page
    rewrite ^/jeux/(retard|cavale|temoins|livraison)/api/scores$ /api/games/$1/scores last;

    # --- Site réservé aux invités (activable dans l'admin, onglet Sécurité) ---
    # Avant chaque page, Nginx demande à l'API si le visiteur a le droit de la voir.
    # Sans session invité : redirection vers la page de connexion /acces/.
    auth_request /_acces;
    error_page 401 = @connexion;
    location = /_acces {
        internal;
        auth_request off;
        proxy_pass http://api:3000/api/access/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
    location @connexion {
        auth_request off;
        return 302 /acces/?r=$uri;
    }
    # Toujours accessibles : page de connexion, styles et scripts communs (sans aucune donnée)
    location ^~ /acces/ {
        auth_request off;
        expires -1;
    }
    location ^~ /css/ {
        auth_request off;
        expires -1;
        etag on;
    }
    location ^~ /js/ {
        auth_request off;
        expires -1;
        etag on;
    }
    location = /favicon.svg {
        auth_request off;
    }

    # Sonde de santé du conteneur
    location = /healthz {
        auth_request off;
        access_log off;
        return 200 "ok\n";
    }

    # --- API ---
    # Album photo : envoi de photos et vidéos (gros fichiers, transmis en flux à l'API)
    location = /api/album/upload {
        auth_request off;
        client_max_body_size 2100m;
        proxy_request_buffering off;
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Vérification de l'album dans l'admin : test de la taille maximale acceptée
    location = /api/admin/album/test-upload {
        auth_request off;
        client_max_body_size 2100m;
        proxy_request_buffering off;
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/ {
        auth_request off; # l'API vérifie elle-même l'accès
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        # $http_host conserve le port (utile pour tester en http://IP:port sur le réseau local)
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 30s;
    }

    # --- Fichiers statiques ---
    # Bibliothèques et polices : cache long
    location ^~ /vendor/ {
        auth_request off;
        expires 30d;
        access_log off;
    }

    # CSS / JS : le navigateur revérifie à chaque visite (réponse « 304 » très légère si rien n'a changé),
    # ainsi une mise à jour du site est visible immédiatement, sans vider le cache
    location ~* \.(css|js)$ {
        expires -1;
        etag on;
    }

    # Administration : protégée par son propre mot de passe
    location ^~ /admin/ {
        auth_request off;
        try_files $uri $uri/ /admin/index.html;
        expires -1;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
